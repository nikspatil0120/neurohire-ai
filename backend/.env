# NeuroHire AI Backend Configuration

# App Settings
APP_NAME=NeuroHire AI
DEBUG=true
VERSION=1.0.0

# Security
SECRET_KEY=your-secret-key-change-in-production-this-is-for-development-only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database URLs (optional for development)
POSTGRES_URL=
MONGODB_URL=
MONGODB_DB=neurohire_ai
REDIS_URL=redis://localhost:6379

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# File Storage
STORAGE_PATH=storage
MAX_FILE_SIZE=10485760

# AI Models (optional)
WHISPER_MODEL=base
TTS_MODEL=tts_models/en/ljspeech/tacotron2-DDC
OPENAI_API_KEY=

# External APIs (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
